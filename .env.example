# Para qué lado se giran las dobles que vienen guardadas acostadas: 90 o 270.
# La forma de la página no lo puede decidir, porque girar 90° o 270° deja la
# misma forma. Es una sola decisión por tomo y se cambia con un botón desde la
# interfaz, así que este valor es sólo el punto de partida.
GIRO_DOBLES=270

# Resolución con la que se leen las páginas cuando la entrada es un PDF
PDF_RENDER_DPI=200

# Alto de página del PDF final, en puntos (756 pt = 10.5 pulgadas)
PAGE_HEIGHT_PT=756

# Tamaño máximo del archivo que se puede subir, en MB. Un tomo escaneado
# puede pesar cientos de MB.
MAX_UPLOAD_MB=2048
